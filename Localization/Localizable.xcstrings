    "Screen Recording takes effect after Docklane restarts.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسري إذن تسجيل الشاشة بعد إعادة تشغيل Docklane."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Docklane আবার চালু হলে স্ক্রিন রেকর্ডিংয়ের অনুমতি কার্যকর হবে।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El permiso de grabación de pantalla se aplica cuando Docklane se reinicia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation d’enregistrement de l’écran prend effet après le redémarrage de Docklane."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन रिकॉर्डिंग की अनुमति Docklane के फिर से शुरू होने पर लागू होती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izin Perekaman Layar berlaku setelah Docklane dimulai ulang."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A permissão de gravação de tela entra em vigor após reiniciar o Docklane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение на запись экрана вступит в силу после перезапуска Docklane."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
