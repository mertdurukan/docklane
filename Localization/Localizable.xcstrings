    "Automatically hide and show the panel": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إخفاء اللوحة وإظهارها تلقائيًا"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্যানেল স্বয়ংক্রিয়ভাবে লুকান ও দেখান"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar y mostrar el panel automáticamente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer et afficher automatiquement le panneau"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पैनल को अपने-आप छिपाएँ और दिखाएँ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembunyikan dan tampilkan panel secara otomatis"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar e mostrar o painel automaticamente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически скрывать и показывать панель"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paneli otomatik olarak gizle ve göster"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动隐藏和显示面板"
          }
        }
