          }
        }
      }
    },
    "Screen Recording takes effect after Docklane restarts.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسري إذن تسجيل الشاشة بعد إعادة تشغيل Docklane."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Docklane আবার চালু হলে স্ক্রিন রেকর্ডিংয়ের অনুমতি কার্যকর হবে।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El permiso de grabación de pantalla se aplica cuando Docklane se reinicia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation d’enregistrement de l’écran prend effet après le redémarrage de Docklane."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन रिकॉर्डिंग की अनुमति Docklane के फिर से शुरू होने पर लागू होती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izin Perekaman Layar berlaku setelah Docklane dimulai ulang."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A permissão de gravação de tela entra em vigor após reiniciar o Docklane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение на запись экрана вступит в силу после перезапуска Docklane."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran kaydı izni Docklane yeniden başlayınca geçerli olur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕录制权限将在 Docklane 重新启动后生效。"
          }
        }
      }
    },
    "See your windows, switch between them and keep your layout.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شاهد نوافذك وتنقّل بينها وحافظ على ترتيبك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার উইন্ডো দেখুন, সেগুলোর মধ্যে যান এবং বিন্যাস ধরে রাখুন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve tus ventanas, cambia entre ellas y conserva tu disposición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez vos fenêtres, passez de l’une à l’autre et gardez votre disposition."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी विंडो देखें, उनके बीच स्विच करें और अपना लेआउट बनाए रखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat jendela Anda, beralih di antaranya, dan pertahankan tata letak Anda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja suas janelas, alterne entre elas e mantenha seu layout."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Видите все окна, переключайтесь между ними и сохраняйте свою раскладку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencerelerini gör, aralarında geçiş yap ve çalışma düzenini koru."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看窗口、在窗口间切换，并保持你的布局。"
          }
        }
      }
    },
