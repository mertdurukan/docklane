    "Replaces the macOS app switcher while Docklane runs. To keep the system's ⌘Tab, choose ⌥Tab.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحل محل مبدّل التطبيقات في macOS أثناء تشغيل Docklane. للإبقاء على ⌘Tab الخاص بالنظام، اختر ⌥Tab."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Docklane চলার সময় এটি macOS-এর অ্যাপ সুইচারের জায়গা নেয়। সিস্টেমের ⌘Tab রাখতে ⌥Tab বেছে নিন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustituye al selector de apps de macOS mientras Docklane está abierto. Para conservar el ⌘Tab del sistema, elige ⌥Tab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace le sélecteur d’apps de macOS tant que Docklane est ouvert. Pour garder le ⌘Tab du système, choisissez ⌥Tab."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Docklane चलते समय यह macOS के ऐप स्विचर की जगह लेता है। सिस्टम का ⌘Tab रखने के लिए ⌥Tab चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggantikan pengalih app macOS selama Docklane berjalan. Untuk mempertahankan ⌘Tab sistem, pilih ⌥Tab."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitui o alternador de apps do macOS enquanto o Docklane está aberto. Para manter o ⌘Tab do sistema, escolha ⌥Tab."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока Docklane запущен, заменяет переключатель приложений macOS. Чтобы оставить системный ⌘Tab, выберите ⌥Tab."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Docklane çalışırken macOS'un uygulama değiştiricisinin yerini alır. Sistemin ⌘Tab'ını korumak için ⌥Tab'ı seç."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Docklane 运行时会取代 macOS 的应用切换器。若要保留系统的 ⌘Tab，请选择 ⌥Tab。"
          }
        }
      }
    },
