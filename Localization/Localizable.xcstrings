    "Press again for a third, then two thirds": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مجددًا للثلث، ثم للثلثين"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আবার চাপুন: এক-তৃতীয়াংশ, তারপর দুই-তৃতীয়াংশ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa otra vez: un tercio y luego dos tercios"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez encore : un tiers, puis deux tiers"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फिर दबाएँ: एक-तिहाई, फिर दो-तिहाई"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan lagi: sepertiga, lalu dua pertiga"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione de novo: um terço, depois dois terços"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите ещё раз: треть, затем две трети"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar bas: üçte bir, sonra üçte iki"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再按一次为三分之一，再按为三分之二"
          }
        }
      }
    },
    "Press ⌃⌥⌘ and a layout's number to open it from anywhere. ⌃⌥Z undoes the last arrangement.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط ⌃⌥⌘ ورقم التخطيط لفتحه من أي مكان. يتراجع ⌃⌥Z عن آخر ترتيب."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেকোনো জায়গা থেকে লেআউট খুলতে ⌃⌥⌘ ও তার নম্বর চাপুন। ⌃⌥Z শেষ বিন্যাস পূর্বাবস্থায় ফেরায়।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa ⌃⌥⌘ y el número de una disposición para abrirla desde cualquier lugar. ⌃⌥Z deshace la última colocación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur ⌃⌥⌘ et le numéro d’une disposition pour l’ouvrir depuis n’importe où. ⌃⌥Z annule le dernier placement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी भी जगह से लेआउट खोलने के लिए ⌃⌥⌘ और उसका नंबर दबाएँ। ⌃⌥Z पिछली व्यवस्था को पहले जैसा करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan ⌃⌥⌘ dan nomor tata letak untuk membukanya dari mana saja. ⌃⌥Z membatalkan penataan terakhir."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione ⌃⌥⌘ e o número de um layout para abri-lo de qualquer lugar. ⌃⌥Z desfaz o último posicionamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите ⌃⌥⌘ и номер раскладки, чтобы открыть её откуда угодно. ⌃⌥Z отменяет последнее размещение."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydettiğin bir düzeni her yerden açmak için ⌃⌥⌘ ile düzenin numarasına bas. ⌃⌥Z son yerleştirmeyi geri alır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何地方按下 ⌃⌥⌘ 和布局编号即可打开它。⌃⌥Z 撤销上一次排列。"
          }
        }
      }
    },
