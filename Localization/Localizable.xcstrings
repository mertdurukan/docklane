    "Previews of windows on another desktop or in full screen get a “Desktop 2” or “Full Screen” label.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر على معاينات النوافذ الموجودة على سطح مكتب آخر أو بملء الشاشة عبارة “سطح المكتب 2” أو “شاشة كاملة”."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য ডেস্কটপের বা পূর্ণ স্ক্রিনের উইন্ডোর প্রিভিউতে “ডেস্কটপ 2” বা “পূর্ণ স্ক্রিন” লেখা থাকে।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las vistas previas de ventanas en otro escritorio o a pantalla completa muestran “Escritorio 2” o “Pantalla completa”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les aperçus des fenêtres d’un autre bureau ou en plein écran affichent « Bureau 2 » ou « Plein écran »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरे डेस्कटॉप पर या फ़ुल स्क्रीन वाली विंडो के प्रीव्यू पर “डेस्कटॉप 2” या “फ़ुल स्क्रीन” लिखा दिखता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratinjau jendela di desktop lain atau layar penuh diberi label “Desktop 2” atau “Layar Penuh”."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As pré-visualizações de janelas em outra mesa ou em tela cheia mostram “Mesa 2” ou “Tela cheia”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На превью окон с другого рабочего стола или в полноэкранном режиме появляется «Рабочий стол 2» или «Полный экран»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka masaüstündeki ya da tam ekrandaki pencerelerin önizlemesinde “Masaüstü 2” veya “Tam ekran” yazar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他桌面上或全屏幕的窗口，其预览上会显示“桌面 2”或“全屏幕”标签。"
          }
        }
      }
    },
    "Puts a frosted backdrop behind the previews.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضع خلفية مصنفرة خلف المعاينات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রিভিউগুলোর পেছনে ঘষা কাচের মতো পটভূমি দেয়।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca un fondo esmerilado detrás de las vistas previas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Place un fond dépoli derrière les aperçus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रीव्यू के पीछे धुंधली काँच जैसी पृष्ठभूमि लगाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menambahkan latar buram di belakang pratinjau."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca um fundo fosco atrás das pré-visualizações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет матовую подложку под превью."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önizlemelerin arkasına buzlu bir zemin koyar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在预览后面加上一层磨砂背景。"
          }
        }
      }
    },
