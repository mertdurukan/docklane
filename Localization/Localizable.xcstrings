    "Keyboard navigation: arrows or Tab move, Return switches, Esc leaves.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التنقل بلوحة المفاتيح: الأسهم أو Tab للتحرك، وReturn للانتقال، وEsc للخروج."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিবোর্ড নেভিগেশন: তীর বা Tab দিয়ে সরান, Return দিয়ে যান, Esc দিয়ে বের হন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Navegación con teclado: las flechas o Tab mueven, Retorno cambia, Esc sale."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Navigation au clavier : les flèches ou Tab déplacent, Retour bascule, Échap quitte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कीबोर्ड नेविगेशन: ऐरो या Tab से आगे बढ़ें, Return से स्विच करें, Esc से बाहर निकलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Navigasi papan ketik: panah atau Tab berpindah, Return beralih, Esc keluar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Navegação pelo teclado: setas ou Tab movem, Return alterna, Esc sai."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управление с клавиатуры: стрелки или Tab — перемещение, Return — переключение, Esc — выход."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavyeyle gezinme: oklar ya da Tab ilerler, Return geçer, Esc çıkar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘导航：方向键或 Tab 移动，Return 切换，Esc 退出。"
          }
        }
      }
    },
