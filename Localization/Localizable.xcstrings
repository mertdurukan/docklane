    "Update with Current Windows": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التحديث بالنوافذ الحالية"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বর্তমান উইন্ডো দিয়ে হালনাগাদ করুন"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizar con las ventanas actuales"
          }
        },
        "fr": {
          "stringUnit": {
