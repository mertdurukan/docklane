    "Window capture and focus techniques follow the approach of AltTab.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتبع تقنيات التقاط النوافذ والتركيز عليها نهج AltTab."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উইন্ডো ক্যাপচার ও ফোকাসের কৌশলগুলো AltTab-এর পদ্ধতি অনুসরণ করে।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las técnicas de captura y enfoque de ventanas siguen el enfoque de AltTab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les techniques de capture et de mise au premier plan des fenêtres suivent l’approche d’AltTab."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विंडो कैप्चर और फ़ोकस की तकनीकें AltTab के तरीके पर आधारित हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teknik penangkapan dan pemfokusan jendela mengikuti pendekatan AltTab."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As técnicas de captura e foco de janelas seguem a abordagem do AltTab."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Методы захвата и фокусировки окон следуют подходу AltTab."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencere yakalama ve odaklama teknikleri AltTab'ın yaklaşımını izler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口捕获和聚焦技术参照了 AltTab 的方法。"
          }
        }
      }
    },
