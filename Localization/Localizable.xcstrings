          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabitlenmiş uygulamalar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定的应用"
          }
        }
      }
    },
    "Pinned apps come first and stay in the panel even without windows. Drag to reorder.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر التطبيقات المثبتة أولًا وتبقى في اللوحة حتى من دون نوافذ. اسحب لإعادة الترتيب."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পিন করা অ্যাপগুলো সবার আগে আসে এবং কোনো উইন্ডো না থাকলেও প্যানেলে থাকে। ক্রম বদলাতে টেনে আনুন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps fijadas aparecen primero y permanecen en el panel aunque no tengan ventanas. Arrastra para reordenar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps épinglées apparaissent en premier et restent dans le panneau même sans fenêtre. Faites glisser pour réorganiser."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिन किए गए ऐप्स सबसे पहले आते हैं और विंडो न होने पर भी पैनल में रहते हैं। क्रम बदलने के लिए ड्रैग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "App yang disematkan tampil paling depan dan tetap di panel meski tanpa jendela. Seret untuk mengurutkan ulang."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os apps fixados aparecem primeiro e permanecem no painel mesmo sem janelas. Arraste para reordenar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закреплённые приложения идут первыми и остаются на панели даже без окон. Перетащите, чтобы изменить порядок."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabitlenmiş uygulamalar en başta gelir ve penceresi olmasa da panelde kalır. Sıralamak için sürükle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定的应用排在最前，即使没有窗口也会留在面板中。拖移以重新排序。"
          }
        }
      }
    },
