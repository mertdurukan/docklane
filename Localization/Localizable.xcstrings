    "Choose a name that no other layout uses.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر اسمًا لا يستخدمه تخطيط آخر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এমন নাম বেছে নিন যা অন্য কোনো লেআউটে নেই।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un nombre que no use otra disposición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un nom qu’aucune autre disposition n’utilise."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐसा नाम चुनें जो किसी दूसरे लेआउट का न हो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih nama yang belum dipakai tata letak lain."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um nome que nenhum outro layout use."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите название, которое не занято другой раскладкой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir düzenin kullanmadığı bir ad seç."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择其他布局未使用的名称。"
          }
        }
      }
    },
    "Choose where new windows of an app open.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر أين تُفتح النوافذ الجديدة لتطبيق ما."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো অ্যাপের নতুন উইন্ডো কোথায় খুলবে তা বেছে নিন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige dónde se abren las ventanas nuevas de una app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez où s’ouvrent les nouvelles fenêtres d’une app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि किसी ऐप की नई विंडो कहाँ खुलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih tempat jendela baru dari suatu app dibuka."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha onde as novas janelas de um app abrem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, где открываются новые окна приложения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir uygulamanın yeni pencerelerinin nerede açılacağını belirle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择某个应用的新窗口在哪里打开。"
          }
        }
      }
    },
    "Click the front window's preview to minimize it": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصغير النافذة الأمامية عند النقر على معاينتها"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সামনের উইন্ডোর প্রিভিউতে ক্লিক করলে সেটি ছোট করুন"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al hacer clic en la vista previa de la ventana activa, minimizarla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquer sur l’aperçu de la fenêtre active la place dans le Dock"
          }
        },
        "hi": {
