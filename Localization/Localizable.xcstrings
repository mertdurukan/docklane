    "Pinned apps": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التطبيقات المثبتة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পিন করা অ্যাপ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps fijadas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps épinglées"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिन किए गए ऐप्स"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "App yang disematkan"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps fixados"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закреплённые приложения"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabitlenmiş uygulamalar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定的应用"
          }
        }
      }
    },
    "Pinned apps appear at the start of the panel and stay there even without open windows. Drag to reorder. You can also right-click a window in the panel and choose Pin to Panel.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر التطبيقات المثبتة في بداية اللوحة وتبقى فيها حتى بدون نوافذ مفتوحة. اسحب لإعادة الترتيب. يمكنك أيضًا النقر بزر الماوس الأيمن على نافذة في اللوحة واختيار “تثبيت في اللوحة”."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পিন করা অ্যাপ প্যানেলের শুরুতে থাকে এবং কোনো উইন্ডো খোলা না থাকলেও সেখানে থাকে। ক্রম বদলাতে টেনে আনুন। প্যানেলে কোনো উইন্ডোতে রাইট-ক্লিক করে “প্যানেলে পিন করুন”ও বেছে নিতে পারেন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps fijadas aparecen al principio del panel y permanecen aunque no tengan ventanas abiertas. Arrastra para reordenarlas. También puedes hacer clic derecho en una ventana del panel y elegir “Fijar en el panel”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps épinglées apparaissent au début du panneau et y restent même sans fenêtre ouverte. Faites glisser pour les réordonner. Vous pouvez aussi cliquer avec le bouton droit sur une fenêtre du panneau et choisir « Épingler au panneau »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिन किए गए ऐप्स पैनल की शुरुआत में दिखते हैं और कोई विंडो खुली न हो तब भी वहीं रहते हैं। क्रम बदलने के लिए खींचें। आप पैनल में किसी विंडो पर राइट-क्लिक करके “पैनल में पिन करें” भी चुन सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "App yang disematkan muncul di awal panel dan tetap ada meski tidak ada jendela yang terbuka. Seret untuk mengurutkan. Anda juga bisa klik kanan jendela di panel lalu pilih “Sematkan ke Panel”."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os apps fixados aparecem no início do painel e ficam lá mesmo sem janelas abertas. Arraste para reordenar. Você também pode clicar com o botão direito em uma janela do painel e escolher “Fixar no painel”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закреплённые приложения стоят в начале панели и остаются на ней даже без открытых окон. Перетащите, чтобы изменить порядок. Также можно щёлкнуть правой кнопкой по окну на панели и выбрать «Закрепить на панели»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabitlenen uygulamalar panelin başında görünür; açık penceresi olmasa da panelde kalır. Sıralamak için sürükle. Paneldeki bir pencereye sağ tıklayıp “Panele sabitle”yi de seçebilirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定的应用显示在面板开头，即使没有打开的窗口也会保留。拖移可调整顺序。也可以在面板中右键点按窗口并选择“固定到面板”。"
          }
        }
      }
    },
    "Playing audio": {
      "localizations": {
        "ar": {
          "stringUnit": {
