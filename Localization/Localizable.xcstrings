    "A permission Docklane needs is off": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أحد الأذونات التي يحتاجها Docklane متوقف"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Docklane-এর দরকারি একটি অনুমতি বন্ধ আছে"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un permiso que Docklane necesita está desactivado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autorisation nécessaire à Docklane est désactivée"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Docklane के लिए ज़रूरी एक अनुमति बंद है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izin yang dibutuhkan Docklane nonaktif"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma permissão de que o Docklane precisa está desativada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключено разрешение, нужное Docklane"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Docklane'in ihtiyaç duyduğu bir izin kapalı"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Docklane 所需的一项权限已关闭"
          }
        }
      }
    },
