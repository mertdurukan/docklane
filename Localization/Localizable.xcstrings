        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tata letak jendela tersimpan"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Layouts de janelas salvos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённые раскладки окон"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilen pencere düzenleri"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存储的窗口布局"
          }
        }
      }
    },
    "Saves the open apps and where each window is. Layout name:": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ التطبيقات المفتوحة وموضع كل نافذة. اسم التخطيط:"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "খোলা অ্যাপ ও প্রতিটি উইন্ডোর অবস্থান সংরক্ষণ করে। লেআউটের নাম:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda las apps abiertas y la posición de cada ventana. Nombre de la disposición:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre les apps ouvertes et la position de chaque fenêtre. Nom de la disposition :"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खुले ऐप्स और हर विंडो की जगह सहेजता है। लेआउट का नाम:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan app yang terbuka dan posisi setiap jendela. Nama tata letak:"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva os apps abertos e a posição de cada janela. Nome do layout:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет открытые приложения и положение каждого окна. Название раскладки:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık uygulamaları ve her pencerenin yerini kaydeder. Düzen adı:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储打开的应用以及每个窗口的位置。布局名称："
          }
        }
      }
    },
    "Saves the open apps and where each window is. Opening the layout later starts apps that aren't running and moves the windows back; it doesn't reopen closed documents or tabs.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ التطبيقات المفتوحة وموضع كل نافذة. عند فتح التخطيط لاحقًا يشغّل التطبيقات غير المفتوحة ويعيد النوافذ إلى أماكنها؛ ولا يعيد فتح المستندات أو علامات التبويب المغلقة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "খোলা অ্যাপ ও প্রতিটি উইন্ডোর অবস্থান সংরক্ষণ করে। পরে লেআউট খুললে বন্ধ অ্যাপ চালু হয় ও উইন্ডো আগের জায়গায় ফেরে; বন্ধ করা ডকুমেন্ট বা ট্যাব আবার খোলে না।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda las apps abiertas y la posición de cada ventana. Al abrir la disposición más tarde, inicia las apps que no estén abiertas y devuelve las ventanas a su sitio; no vuelve a abrir documentos ni pestañas cerrados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre les apps ouvertes et la position de chaque fenêtre. Ouvrir la disposition plus tard lance les apps fermées et remet les fenêtres en place ; les documents et onglets fermés ne sont pas rouverts."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खुले ऐप्स और हर विंडो की जगह सहेजता है। बाद में लेआउट खोलने पर बंद ऐप्स शुरू होते हैं और विंडो अपनी जगह लौटती हैं; बंद किए गए दस्तावेज़ या टैब फिर से नहीं खुलते।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan app yang terbuka dan posisi setiap jendela. Saat tata letak dibuka nanti, app yang belum berjalan akan dimulai dan jendela dikembalikan; dokumen atau tab yang sudah ditutup tidak dibuka ulang."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva os apps abertos e a posição de cada janela. Ao abrir o layout depois, os apps fechados são iniciados e as janelas voltam ao lugar; documentos e abas fechados não são reabertos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет открытые приложения и положение каждого окна. При открытии раскладки запускает незапущенные приложения и возвращает окна на места; закрытые документы и вкладки не открываются заново."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık uygulamaları ve her pencerenin yerini kaydeder. Düzeni sonra açtığında çalışmayan uygulamaları başlatır ve pencereleri kaydedilen yerlerine taşır; kapatılmış belgeleri ya da sekmeleri yeniden açmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储打开的应用以及每个窗口的位置。之后打开此布局时，会启动未运行的应用并把窗口移回原位；不会重新打开已关闭的文稿或标签页。"
          }
        }
      }
    },
    "Screen & System Audio Recording": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الشاشة وصوت النظام"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ক্রিন ও সিস্টেম অডিও রেকর্ডিং"
          }
        },
        "es": {
          "stringUnit": {
