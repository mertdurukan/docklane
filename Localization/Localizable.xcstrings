    "The macOS Dock is on the same edge, so both appear together. Move it in System Settings → Desktop & Dock.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock في macOS على الحافة نفسها، لذا يظهران معًا. انقله من إعدادات النظام ← سطح المكتب وDock."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS Dock একই কিনারায় আছে, তাই দুটো একসাথে দেখা যায়। সিস্টেম সেটিংস → ডেস্কটপ ও Dock থেকে এটি সরান।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Dock de macOS está en el mismo borde, así que ambos aparecen juntos. Muévelo en Ajustes del Sistema → Escritorio y Dock."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Dock de macOS est sur le même bord, les deux apparaissent donc ensemble. Déplacez-le dans Réglages Système → Bureau et Dock."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS Dock उसी किनारे पर है, इसलिए दोनों एक साथ दिखते हैं। इसे सिस्टम सेटिंग्ज़ → डेस्कटॉप और Dock में ले जाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock macOS berada di tepi yang sama, jadi keduanya muncul bersamaan. Pindahkan di Pengaturan Sistem → Desktop & Dock."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Dock do macOS está na mesma borda, então os dois aparecem juntos. Mova-o em Ajustes do Sistema → Mesa e Dock."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock macOS находится у того же края, поэтому они появляются вместе. Переместите его в Системных настройках → Рабочий стол и Dock."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS Dock'u aynı kenarda, bu yüzden ikisi birlikte açılır. Sistem Ayarları → Masaüstü ve Dock'tan taşıyabilirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 程序坞位于同一边缘，因此两者会一起出现。请在“系统设置”→“桌面与程序坞”中移动它。"
          }
        }
      }
    },
