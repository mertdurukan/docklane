    "Previews of these apps are blurred in the panel, the switcher and the large preview.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر معاينات هذه التطبيقات مموهة في اللوحة ومبدّل النوافذ والمعاينة الكبيرة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অ্যাপগুলোর প্রিভিউ প্যানেল, সুইচার ও বড় প্রিভিউতে ঝাপসা দেখায়।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las vistas previas de estas apps se desenfocan en el panel, el selector y la vista previa grande."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les aperçus de ces apps sont floutés dans le panneau, le sélecteur et le grand aperçu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इन ऐप्स के प्रीव्यू पैनल, स्विचर और बड़े प्रीव्यू में धुंधले दिखते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratinjau app ini diburamkan di panel, pengalih, dan pratinjau besar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As pré-visualizações destes apps ficam desfocadas no painel, no alternador e na pré-visualização grande."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Превью этих приложений размываются на панели, в переключателе и в большом превью."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulamaların önizlemeleri panelde, pencere değiştiricide ve büyük önizlemede bulanık görünür."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些应用的预览在面板、切换器和大预览中会被模糊处理。"
          }
        }
      }
    },
