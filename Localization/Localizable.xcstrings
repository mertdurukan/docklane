    "Right-click a window and choose Hide Preview to blur that app's previews.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر بزر الماوس الأيمن على نافذة واختر «إخفاء المعاينة» لتمويه معاينات ذلك التطبيق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো উইন্ডোতে রাইট-ক্লিক করে “প্রিভিউ লুকান” বেছে নিলে সেই অ্যাপের প্রিভিউ ঝাপসা হবে।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic derecho en una ventana y elige «Ocultar vista previa» para desenfocar las vistas previas de esa app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez avec le bouton droit sur une fenêtre et choisissez « Masquer l’aperçu » pour flouter les aperçus de cette app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी विंडो पर राइट-क्लिक करें और उस ऐप के प्रीव्यू धुंधले करने के लिए “प्रीव्यू छिपाएँ” चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik kanan jendela dan pilih “Sembunyikan Pratinjau” untuk memburamkan pratinjau app tersebut."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique com o botão direito em uma janela e escolha “Ocultar pré-visualização” para desfocar as pré-visualizações desse app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Щёлкните окно правой кнопкой и выберите «Скрыть превью», чтобы размыть превью этого приложения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir pencereye sağ tıklayıp \"Önizlemeyi gizle\" ile o uygulamanın önizlemelerini bulanıklaştırabilirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右键点按窗口并选择“隐藏预览”，即可模糊该应用的预览。"
          }
        }
      }
    },
    "Right-click a window and choose Keep in Dock to pin its app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر بزر الماوس الأيمن على نافذة واختر «الإبقاء في Dock» لتثبيت تطبيقها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো উইন্ডোতে রাইট-ক্লিক করে “Dock-এ রাখুন” বেছে নিলে তার অ্যাপ পিন হবে।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic derecho en una ventana y elige «Mantener en el Dock» para fijar su app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez avec le bouton droit sur une fenêtre et choisissez « Garder dans le Dock » pour épingler son app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी विंडो पर राइट-क्लिक करें और उसके ऐप को पिन करने के लिए “Dock में रखें” चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik kanan jendela dan pilih “Simpan di Dock” untuk menyematkan app-nya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique com o botão direito em uma janela e escolha “Manter no Dock” para fixar o app dela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Щёлкните окно правой кнопкой и выберите «Оставить в Dock», чтобы закрепить его приложение."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir pencereye sağ tıklayıp \"Dock'ta tut\" ile uygulamasını sabitleyebilirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右键点按窗口并选择“在程序坞中保留”，即可固定其应用。"
          }
        }
      }
    },
