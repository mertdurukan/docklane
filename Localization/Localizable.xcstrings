{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%@ is already used by another app. Choose another shortcut.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم تطبيق آخر %@ بالفعل. اختر اختصارًا آخر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ইতিমধ্যে অন্য একটি অ্যাপ ব্যবহার করছে। অন্য শর্টকাট বেছে নিন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra app ya usa %@. Elige otro atajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est déjà utilisé par une autre app. Choisissez un autre raccourci."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पहले से किसी दूसरे ऐप में इस्तेमाल हो रहा है। दूसरा शॉर्टकट चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sudah dipakai app lain. Pilih pintasan lain."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ já é usado por outro app. Escolha outro atalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ уже используется другим приложением. Выберите другое сочетание."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ başka bir uygulama tarafından kullanılıyor. Başka bir kısayol seç."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已被其他应用使用。请选择其他快捷键。"
          }
        }
      }
    },
    "%lld windows · %lld apps": {
      "localizations": {
        "ar": {
