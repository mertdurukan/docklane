    "Enter a layout name to save.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل اسمًا للتخطيط لحفظه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংরক্ষণ করতে লেআউটের নাম লিখুন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe un nombre para guardar la disposición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un nom pour enregistrer la disposition."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजने के लिए लेआउट का नाम लिखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan nama tata letak untuk menyimpan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite um nome para salvar o layout."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите название, чтобы сохранить раскладку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydetmek için bir düzen adı gir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入布局名称以存储。"
          }
        }
      }
    },
    "Enter a name for this %@ window:": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل اسمًا لنافذة %@ هذه:"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই %@ উইন্ডোর জন্য একটি নাম লিখুন:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe un nombre para esta ventana de %@:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un nom pour cette fenêtre %@ :"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस %@ विंडो के लिए नाम दर्ज करें:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan nama untuk jendela %@ ini:"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite um nome para esta janela do %@:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите имя для этого окна %@:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu %@ penceresi için bir ad yaz:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为这个“%@”窗口输入名称："
          }
        }
      }
    },
    "Every open window, at a glance.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل نوافذك المفتوحة، بنظرة واحدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সব খোলা উইন্ডো, এক নজরে।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas tus ventanas abiertas, de un vistazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes vos fenêtres ouvertes, d’un coup d’œil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर खुली विंडो, एक नज़र में।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua jendela yang terbuka, sekilas pandang."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as janelas abertas, num relance."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все открытые окна — с одного взгляда."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm açık pencerelerin, tek bakışta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有打开的窗口，一目了然。"
          }
        }
      }
    },
    "Fill Screen": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملء الشاشة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ক্রিন ভরান"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llenar pantalla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplir l’écran"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन भरें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Isi Layar"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Preencher a tela"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заполнить экран"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekranı doldur"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填满屏幕"
          }
        }
      }
    },
    "Finds your windows, brings the one you choose to the front and arranges them. The ⌘Tab window switcher also needs it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعثر على نوافذك ويُحضر النافذة التي تختارها إلى المقدمة ويرتّبها. يحتاجه أيضًا مبدّل النوافذ ⌘Tab."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার উইন্ডো খুঁজে পেতে, বেছে নেওয়াটি সামনে আনতে ও সাজাতে লাগে। ⌘Tab উইন্ডো সুইচারেরও এটি দরকার।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra tus ventanas, trae al frente la que elijas y las coloca. El selector de ventanas ⌘Tab también lo necesita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve vos fenêtres, met au premier plan celle que vous choisissez et les dispose. Le sélecteur de fenêtres ⌘Tab en a aussi besoin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी विंडो ढूँढने, चुनी गई विंडो को आगे लाने और उन्हें व्यवस्थित करने के लिए। ⌘Tab विंडो स्विचर को भी इसकी ज़रूरत है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menemukan jendela Anda, membawa jendela pilihan ke depan, dan menatanya. Pengalih jendela ⌘Tab juga memerlukannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontra suas janelas, traz para a frente a que você escolher e as organiza. O alternador de janelas ⌘Tab também precisa dela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Находит ваши окна, выводит выбранное на передний план и размещает окна. Переключателю окон ⌘Tab оно тоже нужно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencerelerini bulmak, seçtiğini öne getirmek ve yerleştirmek için kullanılır. ⌘Tab pencere değiştiricisi de bu izinle çalışır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于查找窗口、把你选择的窗口移到最前面并排列窗口。⌘Tab 窗口切换器也需要它。"
          }
        }
      }
    },
