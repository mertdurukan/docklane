    "Brings the window you click to the front and keeps windows clear of the panel.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحضر النافذة التي تنقر عليها إلى الأمام ويُبعد النوافذ عن اللوحة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যে উইন্ডোতে ক্লিক করেন সেটিকে সামনে আনে এবং উইন্ডোগুলোকে প্যানেল থেকে দূরে রাখে।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva al frente la ventana en la que haces clic y mantiene las ventanas fuera del panel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met au premier plan la fenêtre sur laquelle vous cliquez et éloigne les fenêtres du panneau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप जिस विंडो पर क्लिक करते हैं उसे सामने लाता है और विंडो को पैनल से दूर रखता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membawa jendela yang Anda klik ke depan dan menjauhkan jendela dari panel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Traz para a frente a janela em que você clica e mantém as janelas longe do painel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выводит на передний план окно, по которому вы щёлкнули, и не даёт окнам заходить под панель."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tıkladığın pencereyi öne getirir ve pencereleri panelin önünden uzak tutar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将你点按的窗口置于最前，并让窗口避开面板。"
          }
        }
      }
    },
