    "Both shortcuts are the same, so keyboard navigation is off. Choose another shortcut for one of them.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاختصاران متطابقان، لذا التنقل بلوحة المفاتيح متوقف. اختر اختصارًا آخر لأحدهما."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দুটি শর্টকাট একই, তাই কীবোর্ড দিয়ে চলাচল বন্ধ আছে। একটির জন্য অন্য শর্টকাট বেছে নিন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dos atajos son iguales, así que la navegación con el teclado está desactivada. Elige otro atajo para uno de ellos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux raccourcis sont identiques : la navigation au clavier est donc désactivée. Choisissez un autre raccourci pour l’un d’eux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोनों शॉर्टकट एक जैसे हैं, इसलिए कीबोर्ड नेविगेशन बंद है। किसी एक के लिए दूसरा शॉर्टकट चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedua pintasan sama, jadi navigasi papan ketik nonaktif. Pilih pintasan lain untuk salah satunya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dois atalhos são iguais, então a navegação pelo teclado está desativada. Escolha outro atalho para um deles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оба сочетания одинаковые, поэтому навигация с клавиатуры отключена. Выберите другое сочетание для одного из них."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki kısayol aynı olduğu için klavyeyle gezinme kapalı. Birine başka bir kısayol seç."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个快捷键相同，因此键盘导航已关闭。请为其中一个选择其他快捷键。"
          }
        }
      }
    },
